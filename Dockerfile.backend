# Build stage
FROM rust:1.70 as builder

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates/logler-core ./crates/logler-core
COPY logler-server ./logler-server
COPY logler-cli ./logler-cli

RUN cargo build --release --bin logler-server

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/logler-server /app/logler-server

EXPOSE 3000

ENV RUST_LOG=info

CMD ["/app/logler-server"]
